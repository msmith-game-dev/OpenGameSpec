{
  "name": "opengamespec-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The website for the OpenGameSpec family of open game content specifications.",
  "license": "Apache-2.0",
  "author": "Arctic Flame Games Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msmith-game-dev/OpenGameSpec.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "validate:registry": "node scripts/validate-registry.mjs",
    "build": "npm run validate:registry && tsc -b && vite build",
